# Dataset curation / labeling tools (FiftyOne workflow) and tests.
# Edit this file, then regenerate the lock file:
#   uv pip compile requirements-dev.in -o requirements-dev.txt --index-strategy unsafe-best-match \
#     --emit-index-url --no-emit-package opencv-python-headless
# opencv-python-headless (pulled in by fiftyone) is excluded because it clobbers
# opencv-python's cv2 module, which needs GUI support for cv2.imshow.

-c requirements.txt

fiftyone
ipython         # labeling workflow runs in an IPython session (ipython -i start_51.py, %run -i ...)
pytest
